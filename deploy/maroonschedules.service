# systemd unit for the MaroonSchedules FastAPI backend.
# Installed by deploy/setup_ec2.sh, which replaces the __PLACEHOLDERS__.
# Env vars come from the repo's .env / Backend/.env files, which the app
# loads itself on startup (see Backend/main.py) — nothing to configure here.

[Unit]
Description=MaroonSchedules FastAPI backend
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DEPLOY_PATH__/Backend
ExecStart=__DEPLOY_PATH__/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
