# Expo frontend environment variables
# Copy this file to .env for local development.

# Backend base URL (no trailing slash). Must be reachable from the device:
# - iOS Simulator: http://127.0.0.1:8000 is fine if uvicorn binds 0.0.0.0:8000
# - Physical phone: use your computer's current LAN IPv4 (Settings → Wi‑Fi → your network on Mac shows it).
#   If this IP is wrong or you're on different Wi‑Fi, buses / dining / occupancy will time out and look "broken".
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IPV4:8000

# Optional: default 8000 ms; lower for faster failure when debugging a dead host (min 3000).
# EXPO_PUBLIC_API_TIMEOUT_MS=6000

# Clerk publishable key already used by the app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# App-level API key.
# This is bundled with the app, so it is an app identifier and abuse control layer, not a user secret.
EXPO_PUBLIC_API_KEY=replace-with-the-same-api-key-as-your-backend
