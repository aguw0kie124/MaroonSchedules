APP_ENV=production
CLERK_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
API_KEY=replace-with-your-app-api-key
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://maroonlife.app
CLERK_JWT_AUDIENCE=
CLERK_ISSUER=

# Existing backend configuration
CLERK_SECRET_KEY=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
# Redis cache provider
# Works with standard Redis URLs, including Upstash's TCP Redis URL.
# Do not use the Upstash REST URL here; use the redis:// or rediss:// connection string.
REDIS_URL=
UPSTASH_REDIS_URL=

# --- RevAI assistant ---
# LLM provider for RevAI. If GEMINI_API_KEY is set, RevAI uses Google Gemini;
# otherwise it uses OpenRouter (OPENROUTER_API_KEY, shared with event classification).
# Get a key at https://aistudio.google.com/apikey (GOOGLE_API_KEY also works).
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash
# Reasoning is much slower; keep off for a snappy assistant. Set true to enable.
GEMINI_ENABLE_THINKING=false
# Fast lane (simple/greeting questions). Defaults to GEMINI_ASSISTANT_MODEL; set a
# smaller model (e.g. gemini-flash-lite-latest) for snappier simple replies.
GEMINI_FAST_MODEL=
# Agent lane (tool-calling). Defaults to Flash — fast per call, which matters in a
# tool loop. Set a Pro model if answer quality matters more than latency.
GEMINI_AGENT_MODEL=
GEMINI_AGENT_TIMEOUT=18
GEMINI_AGENT_REQUEST_LIMIT=5
OPENROUTER_API_KEY=
# Optional: override RevAI's OpenRouter models (comma-separated). Defaults to DeepSeek v3.
OPENROUTER_ASSISTANT_MODELS=
# Optional: reliable web search for RevAI (free tier at tavily.com). Without it,
# keyless DuckDuckGo is used (entity results only).
TAVILY_API_KEY=
