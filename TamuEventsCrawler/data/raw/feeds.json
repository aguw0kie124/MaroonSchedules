type=\"image\/jpeg\" srcset=\"https:\/\/calendar.tamu.edu\/live\/image\/scale\/2x\/gid\/147\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/11933_Transit_general_graphics_for_postings.rev.1707229391.jpg 2x, https:\/\/calendar.tamu.edu\/live\/image\/scale\/3x\/gid\/147\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/11933_Transit_general_graphics_for_postings.rev.1707229391.jpg 3x\" data-origin=\"responsive\"\/>\n\t<img src=\"https:\/\/calendar.tamu.edu\/live\/image\/gid\/147\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/11933_Transit_general_graphics_for_postings.rev.1707229391.jpg\" alt=\"A row of white buses drive down the street, appearing next to the Transit Aggie Spirit Bus Services logo.\" width=\"200\" height=\"200\" srcset=\"https:\/\/calendar.tamu.edu\/live\/image\/scale\/2x\/gid\/147\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/11933_Transit_general_graphics_for_postings.rev.1707229391.jpg 2x, https:\/\/calendar.tamu.edu\/live\/image\/scale\/3x\/gid\/147\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/11933_Transit_general_graphics_for_postings.rev.1707229391.jpg 3x\" data-max-w=\"1920\" data-max-h=\"1080\" loading=\"lazy\" data-optimized=\"true\"\/>\n<\/picture>\n","image_info":["147","11933_Transit_general_graphics_for_postings","jpg","1","0,0,1920,1080","Transit Aggie Spirit Bus Services","","","A row of white buses drive down the street, appearing next to the Transit Aggie Spirit Bus Services logo."],"repeats_start":1773637200,"repeats_end":1775106000,"is_multi_day":1,"is_first_multi_day":1},{"id":"377612","ts_start":1774846800,"tz":"America\/Chicago","tz_abbrv":"CDT","tz_offset":-18000,"tz_format":"us","href":"event\/377612-week-without-waste","title":"Week Without Waste","status":"1","location":"","summary":"<p>\n  Take the Week Without Waste Challenge! Can you fit all your landfill waste into a Mason jar? Reduce, reuse, recycle, and rethink your habits\u2014let\u2019s see how small you can shrink your waste this week!\n<\/p>\n<p>\n  Learn more and collect your Mason jar (or use your own!) from our office (Pavilion Suite 229) or from our team on <strong>April 1, 2026, 11 a.m.\u20132 p.m., Memorial Student Center<\/strong>, at the Office of Sustainability &amp; Campus Enrichment table!\n<\/p>\n<p>\n  Document your participation in Week Without Waste by filling out <a href=\"https:\/\/forms.gle\/vqafk1wZXy3dTjyn6\">this short form<\/a> and earn up to 20 entries into our Earth Month Grand Prize Drawings. Submissions are due by April 11, 2026<strong>.<\/strong> Points can be earned as follows:\n<\/p>\n<ul>\n  <li>Photo of your jar (or you &amp; your jar) at the end of the week (5 points)\n  <\/li>\n  <li>Reflection (5 points)\n  <\/li>\n  <li>Additional photos (2points\/unique photo MAX 10 - validity determined by OSCE Staff).\n  <\/li>\n<\/ul>To learn more about Campus Earth Month and our grand prize giveaway, see this <a href=\"https:\/\/sustainability.tamu.edu\/get-involved\/earth-day.html\">link<\/a>.","is_all_day":"1","is_starred":"","image_src":"https:\/\/calendar.tamu.edu\/live\/image\/gid\/282\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/16795_Earth_MONTH_-_Social_1.rev.1766169748.jpg","image_raw":"<picture class=\"lw_image\">\n\t<source type=\"image\/webp\" srcset=\"https:\/\/calendar.tamu.edu\/live\/image\/scale\/2x\/gid\/282\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/16795_Earth_MONTH_-_Social_1.rev.1766169748.webp 2x, https:\/\/calendar.tamu.edu\/live\/image\/scale\/3x\/gid\/282\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/16795_Earth_MONTH_-_Social_1.rev.1766169748.webp 3x\" data-origin=\"responsive\"\/>\n\t<source type=\"image\/jpeg\" srcset=\"https:\/\/calendar.tamu.edu\/live\/image\/scale\/2x\/gid\/282\/width\/200\/height\/200\/crop\/1\/src_region\/0,0,1920,1080\/16795_Earth_MONTH_-_Social_1.rev.1766169748.jpg 2x, https:\/\/calendar.tamu.edu\/live\/image\/scale\/3x\/gid\/28